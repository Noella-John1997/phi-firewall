# 32-byte master keys, base64. First one is ACTIVE (used to encrypt); others are kept to decrypt old data.
# Generate one with:  phi-firewall gen-key
PHI_FIREWALL_MASTER_KEYS=k1:REPLACE_WITH_BASE64_KEY

# Where to forward cleaned requests. Use "mock" to run without any LLM account.
UPSTREAM_BASE_URL=mock
UPSTREAM_API_KEY=

# Optional: comma-separated keys clients must send in the X-Firewall-Key header
FIREWALL_API_KEYS=

VAULT_PATH=vault.db
VAULT_TTL_SECONDS=900
AUDIT_LOG_PATH=audit.jsonl
POLICY_PATH=
